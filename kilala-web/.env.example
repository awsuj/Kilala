# Base URL of the Kilala backend API (Express, from backend/).
# Note: the backend's own PORT (see backend/.env) decides this — the team's
# backend runs on 5001, so point here at that. Defaults to 5000 if unset.
API_BASE_URL=http://localhost:5001

# Name of the httpOnly cookie that stores the admin's JWT (optional).
AUTH_COOKIE=kilala_token
